[Unit]
Description=GetRich FastAPI Backend
After=network.target postgresql.service
Wants=postgresql.service
# When ``GETRICH_WORKER_BACKEND=celery`` is set, the API only
# dispatches to Redis via ``app.send_task``; it does NOT need the
# worker pool to be running for POSTs to succeed. We deliberately do
# NOT add ``Wants=getrich-worker.target`` here so a paused worker
# pool does not block API restarts.

[Service]
Type=simple
User=neo
WorkingDirectory=/home/neo/project/getrich
# --workers 1 is REQUIRED when GETRICH_WORKER_BACKEND=inproc (the
# default) because FastAPI BackgroundTasks runs in the request
# thread, and multiple uvicorn workers would each spawn their own
# runner — Postgres ``FOR UPDATE SKIP LOCKED`` de-dupes the job, but
# the per-trial cancel probe + progress writes would scatter across
# processes, complicating operator reasoning. For multi-worker scale,
# set GETRICH_WORKER_BACKEND=celery and remove the --workers 1 flag.
ExecStart=/home/neo/.local/bin/uv run --find-links ./local_packages uvicorn getrich.apps.web.main:app --host 0.0.0.0 --port 8000 --workers 1
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
