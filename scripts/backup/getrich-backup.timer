[Unit]
Description=GetRich daily backup timer
Documentation=https://github.com/getrich/getrich/blob/main/scripts/backup/

[Timer]
# Daily at 02:00 (Asia/Shanghai = 18:00 UTC). PG first, then CH
# 1h later via daily_backup.sh's internal sequencing; the
# artifact step is independent.
OnCalendar=*-*-* 02:00:00
# If we missed the window (system was off), fire on next boot.
Persistent=true
# ±60s jitter to avoid thundering-herd if multiple hosts share
# the same backup target.
RandomizedDelaySec=60s
# Run the getrich-backup.service we just defined.
Unit=getrich-backup.service

[Install]
WantedBy=timers.target
