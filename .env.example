# GetRich 应用运行配置。复制为 .env 后使用，真实 .env 不得提交。
# 数据库容器在仓库外单独部署；这里仅配置应用如何连接已有服务。
# 启动应用前替换所有 change-me-* 值。
# 可使用 openssl rand -hex 24 生成本机密钥。

# Application
APP_ENV=dev
STRICT_MODE=false
TZ=Asia/Shanghai

# PostgreSQL / TimescaleDB
PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=quant
PG_PASSWORD=change-me-local-only
PG_DB=getrich
PG_POOL_MIN=2
PG_POOL_MAX=20

# ClickHouse
CLICKHOUSE_HOST=127.0.0.1
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=quant
CLICKHOUSE_PASSWORD=change-me-local-only
CLICKHOUSE_DB=getrich
CLICKHOUSE_PROTOCOL=http

# Redis and Celery
REDIS_PORT=6379
REDIS_PASSWORD=change-me-local-only
GETRICH_WORKER_BACKEND=celery
GETRICH_BROKER_URL=redis://default:${REDIS_PASSWORD}@127.0.0.1:${REDIS_PORT}/0
GETRICH_RESULT_BACKEND=redis://default:${REDIS_PASSWORD}@127.0.0.1:${REDIS_PORT}/1
GETRICH_FLOWER_URL=http://127.0.0.1:5555

# Optional integrations
ENABLE_HDB=false
ENABLE_INSIGHT=false
INSIGHT_USER=
INSIGHT_PASSWORD=
RICEQUANT_ENABLED=false
RICEQUANT_API_KEY=

# DuckDB
# DUCKDB_PATH=./data/duckdb/getrich.duckdb
# DUCKDB_PARQUET_ROOT=./data/parquet

# Backtest artifacts
BACKTEST_ARTIFACT_DIR=./tmp/artifacts

# FastAPI and authentication
WEB_HOST=0.0.0.0
WEB_PORT=8001
WEB_CORS_ORIGINS=http://localhost:3000
JWT_SECRET=change-me-local-only
JWT_EXPIRE_MINUTES=1440
JWT_REFRESH_EXPIRE_HOURS=168

# Optional payment webhook verification
PAYMENT_WEBHOOK_SECRET=

# Logging
# LOG_LEVEL=DEBUG
# LOG_FMT=[%(asctime)s][%(name)s][%(levelname)s] %(message)s
# LOG_FILE=./logs/getrich.log
