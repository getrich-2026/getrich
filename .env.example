# --- 应用配置 (Application Configuration) ---
APP_ENV  = dev  # 'dev', 'prod', 'research'
STRICT_MODE = false  # 是否启用严格模式 (Enable strict mode), 一般生产环境用 true

# --- Insight 配置 (Insight Configuration) ---

ENABLE_INSIGHT = false  # 是否启用 Insight 功能 (Enable Insight features)
INSIGHT_USER = your_user_here  # Insight 用户名 (Insight username)
INSIGHT_PASSWORD = your_password_here  # Insight 密码 (Insight password)

# --- 数据库配置 (Database Configuration) ---

ENABLE_HDB = false  # 是否启用 HDB 模块 (Enable HDB module import)

CLICKHOUSE_HOST = your_host_here
CLICKHOUSE_PORT = 8123
CLICKHOUSE_USER = default
CLICKHOUSE_PASSWORD = your_password_here
CLICKHOUSE_DB = efault
CLICKHOUSE_PROTOCOL = http


# --- DuckDB 配置 (DuckDB Configuration) ---

# DUCKDB_PATH = ./data/duckdb/getrich.duckdb
# DUCKDB_PARQUET_ROOT = ./data/parquet


# --- RiceQuant 配置 (RiceQuant Configuration) ---

RICEQUANT_ENABLED = false  # 是否启用 RiceQuant 数据源
RICEQUANT_API_KEY = your_api_key_here  # RiceQuant API 密钥


# --- 日志配置 (Logging Configuration) ---

# LOG_LEVEL = DEBUG
# LOG_FMT = [%(asctime)s][%(name)s][%(levelname)s] %(message)s
# LOG_FILE = ./logs/getrich.log
