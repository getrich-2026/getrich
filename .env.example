# Copy this file to .env. Never commit the real .env file.
# Replace every change-me-* value before starting local services.
# Generate a local secret with: openssl rand -hex 24

# Application
APP_ENV=dev
STRICT_MODE=false
TZ=Asia/Shanghai

# Docker Compose host settings
# Keep 127.0.0.1 for local-only access. Exposing database ports publicly is unsafe.
COMPOSE_PROJECT_NAME=getrich
DOCKER_BIND_HOST=127.0.0.1
DOCKER_NETWORK_NAME=quant_network
POSTGRES_CONTAINER_NAME=getrich-pg17
CLICKHOUSE_CONTAINER_NAME=getrich-ch26
REDIS_CONTAINER_NAME=getrich-redis82

# Local paths work on macOS and Linux. A server can use /opt/getrich/... instead.
POSTGRES_DATA_DIR=./.docker/postgres/data
POSTGRES_LOG_DIR=./.docker/postgres/logs
CLICKHOUSE_DATA_DIR=./.docker/clickhouse/data
CLICKHOUSE_LOG_DIR=./.docker/clickhouse/logs
REDIS_DATA_DIR=./.docker/redis/data
REDIS_LOG_DIR=./.docker/redis/logs

# PostgreSQL / TimescaleDB
PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=quant
PG_PASSWORD=change-me-local-only
PG_DB=getrich
PG_POOL_MIN=2
PG_POOL_MAX=20

# ClickHouse
CLICKHOUSE_HOST=127.0.0.1
CLICKHOUSE_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_INTERSERVER_PORT=9009
CLICKHOUSE_USER=quant
CLICKHOUSE_PASSWORD=change-me-local-only
CLICKHOUSE_DB=getrich
CLICKHOUSE_PROTOCOL=http

# Redis and Celery
REDIS_PORT=6379
REDIS_PASSWORD=change-me-local-only
# 内存上限；策略是 noeviction，写满后写入报错而非淘汰 key
REDIS_MAXMEMORY=2gb
GETRICH_WORKER_BACKEND=celery
GETRICH_BROKER_URL=redis://default:${REDIS_PASSWORD}@127.0.0.1:${REDIS_PORT}/0
GETRICH_RESULT_BACKEND=redis://default:${REDIS_PASSWORD}@127.0.0.1:${REDIS_PORT}/1
GETRICH_FLOWER_URL=http://127.0.0.1:5555

# Optional integrations
ENABLE_HDB=false
ENABLE_INSIGHT=false
INSIGHT_USER=
INSIGHT_PASSWORD=
RICEQUANT_ENABLED=false
RICEQUANT_API_KEY=

# DuckDB
# DUCKDB_PATH=./data/duckdb/getrich.duckdb
# DUCKDB_PARQUET_ROOT=./data/parquet

# Backtest artifacts
BACKTEST_ARTIFACT_DIR=./tmp/artifacts

# FastAPI and authentication
WEB_HOST=0.0.0.0
WEB_PORT=8001
WEB_CORS_ORIGINS=http://localhost:3000
JWT_SECRET=change-me-local-only
JWT_EXPIRE_MINUTES=1440
JWT_REFRESH_EXPIRE_HOURS=168

# Optional payment webhook verification
PAYMENT_WEBHOOK_SECRET=

# Logging
# LOG_LEVEL=DEBUG
# LOG_FMT=[%(asctime)s][%(name)s][%(levelname)s] %(message)s
# LOG_FILE=./logs/getrich.log
