[Unit]
Description=GetRich Redis Broker (Celery broker + result backend)
Documentation=https://redis.io/docs/
After=network.target
# Redis is the broker for the Celery worker pool. The worker pool
# (getrich-worker@.service) starts after this service. The API
# (getrich-api.service) does NOT depend on Redis because it uses the
# inproc BackgroundTasks fallback by default; the broker is only
# required when GETRICH_WORKER_BACKEND=celery.
Before=getrich-worker.target

[Service]
Type=simple
User=neo
# Use a project-local Redis config so the broker cannot accidentally
# touch the host's main Redis (separate port / socket / log / data).
# The config file is operator-managed; if absent, the unit falls back
# to a minimal command line so ``systemctl start getrich-broker``
# still works on a fresh install.
ExecStart=/usr/bin/redis-server /etc/redis/getrich.conf --appendonly yes
Restart=on-failure
RestartSec=5
# Protect the broker from disk full: cap memory at 1 GB and evict
# keys LRU-style. Backtest jobs enqueue small messages (a single
# job_id) and the result backend holds only ``SUCCESS/FAILURE`` stubs,
# so 1 GB is plenty for hundreds of queued jobs.
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
