# GetRich 基础设施部署配置模板。
# 请先把 deploy/ 目录中的文件复制到仓库外的部署目录根，再将本文件复制为 .env。
# 真实密码、数据路径和 .env 不得提交到 GetRich 仓库。
# 可使用 openssl rand -hex 24 分别生成数据库密码。

COMPOSE_PROJECT_NAME=getrich
TZ=Asia/Shanghai
DOCKER_BIND_HOST=127.0.0.1
DOCKER_NETWORK_NAME=quant_network

# 容器名称
POSTGRES_CONTAINER_NAME=getrich-pg17
CLICKHOUSE_CONTAINER_NAME=getrich-ch26
REDIS_CONTAINER_NAME=getrich-redis82

# PostgreSQL / TimescaleDB
PG_PORT=5432
PG_USER=quant
PG_PASSWORD=change-me-deployment-only
PG_DB=getrich
POSTGRES_DATA_DIR=./.docker/postgres/data
POSTGRES_LOG_DIR=./.docker/postgres/logs

# ClickHouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_INTERSERVER_PORT=9009
CLICKHOUSE_USER=quant
CLICKHOUSE_PASSWORD=change-me-deployment-only
CLICKHOUSE_DB=getrich
CLICKHOUSE_DATA_DIR=./.docker/clickhouse/data
CLICKHOUSE_LOG_DIR=./.docker/clickhouse/logs

# Redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me-deployment-only
REDIS_MAXMEMORY=2gb
REDIS_DATA_DIR=./.docker/redis/data
REDIS_LOG_DIR=./.docker/redis/logs
