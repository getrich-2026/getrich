# apps/web 前端环境变量。复制为 .env.local 后使用。
#
# 只有 VITE_ 前缀的变量会被 Vite 注入到浏览器包里 —— 这里的值都会**公开可见**，
# 绝不能写数据库地址、密码或任何密钥。后端连接配置在仓库根的 .env。

# 后端 API 基址（gr-api）。需要带上版本前缀 /v1。
VITE_API_BASE_URL=http://127.0.0.1:8000/v1

# 开发期 mock 认证：后端读 X-User-Id 头识别用户，切到真实 JWT 后可删。
# 值必须是 app.users.id 里存在的 UUID。
VITE_DEMO_USER_ID=
